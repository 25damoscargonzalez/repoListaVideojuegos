<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/bIrConsola"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Ir a la consola" />

    <Button
        android:id="@+id/bLista"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Lista" />

    <Button
        android:id="@+id/bCalculadora2"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Calculadora" />

    <ImageButton
        android:id="@+id/bCalculadora"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/calculadora" />

    <Button
        android:id="@+id/bConversor"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Conversor" />

    <Button
        android:id="@+id/bJuegos"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Juegos" />

</LinearLayout>