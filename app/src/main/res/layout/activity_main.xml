<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/bIrConsola"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Ir a la consola"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bLista" />

    <Button
        android:id="@+id/bLista"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:text="Lista"
        app:layout_constraintBottom_toTopOf="@+id/bIrConsola"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bJuegos" />

    <Button
        android:id="@+id/bCalculadora"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Calculadora"
        app:layout_constraintBottom_toTopOf="@+id/bConversor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bConversor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Conversor"
        app:layout_constraintBottom_toTopOf="@+id/bJuegos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bCalculadora" />

    <Button
        android:id="@+id/bJuegos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Juegos"
        app:layout_constraintBottom_toTopOf="@+id/bLista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bConversor" />
</androidx.constraintlayout.widget.ConstraintLayout>